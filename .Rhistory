# 3) replace any NA in the new quintile column with 1
data2010[ is.na(get(newcol)), (newcol) := 1L ]
}
vars <- c( 'tot.prod')
for (v in vars) {
# 1) compute cut‐points only on positive values
cuts <- data2010[, quantile(get(v), probs = quint_probs, na.rm = TRUE)]
# 2) assign the quintile codes (1:5)
newcol <- paste0(v, "_q")
data2010[ , (newcol) :=
cut(get(v),
breaks         = cuts,
include.lowest = TRUE,
labels         = FALSE)]
# 3) replace any NA in the new quintile column with 1
data2010[ is.na(get(newcol)), (newcol) := 1L ]
}
quint_probs <- seq(0, 1, by = 0.333333)
vars <- c("peragri", "tree.mcq", "tot.prod", "tot.prod.log", "rice", "sugc", "whea", "pota", "cotton" )
for (v in vars) {
# 1) compute cut‐points only on positive values
cuts <- data2010[get(v) > 0, quantile(get(v), probs = quint_probs, na.rm = TRUE)]
# 2) assign the quintile codes (1:5)
newcol <- paste0(v, "_t")
data2010[ , (newcol) :=
cut(get(v),
breaks         = cuts,
include.lowest = TRUE,
labels         = FALSE)]
# 3) replace any NA in the new quintile column with 1
data2010[ is.na(get(newcol)), (newcol) := 1L ]
}
quint_probs <- seq(0, 1, by = 0.5)
vars <- c("peragri", "tree.mcq", "rice", "sugc", "whea", "pota", "cotton", "tractors", "banks" )
for (v in vars) {
# 1) compute cut‐points only on positive values
cuts <- data2010[get(v) > 0, quantile(get(v), probs = quint_probs, na.rm = TRUE)]
# 2) assign the quintile codes (1:5)
newcol <- paste0(v, "_am")
data2010[ , (newcol) :=
cut(get(v),
breaks         = cuts,
include.lowest = TRUE,
labels         = FALSE)]
# 3) replace any NA in the new quintile column with 1
data2010[ is.na(get(newcol)), (newcol) := 1L ]
}
vars <- c( 'tot.prod')
for (v in vars) {
# 1) compute cut‐points only on positive values
cuts <- data2010[, quantile(get(v), probs = quint_probs, na.rm = TRUE)]
# 2) assign the quintile codes (1:5)
newcol <- paste0(v, "_am")
data2010[ , (newcol) :=
cut(get(v),
breaks         = cuts,
include.lowest = TRUE,
labels         = FALSE)]
# 3) replace any NA in the new quintile column with 1
data2010[ is.na(get(newcol)), (newcol) := 1L ]
}
# Change the names
vars     <- c( "peragri", "tree.mcq",
"rice",   "sugc",   "whea",     "pota", "perbarren",
"cum_conflicts",
"banks", "tractors")
new_names <- paste0(vars, "2010")
setnames(data2010, old = vars, new = new_names)
names(data2010)
############ Merging data
data <- merge(data, data2010, all.x = TRUE,
by = c("pc11_s_id", "pc11_d_id", "pc11_sd_id"))
data$allobs <- 1
data[, prod_tree_am := as.integer(interaction(tree.mcq_am, tot.prod_am, sep = "_", drop = TRUE))]
data[, prod_agri_am := as.integer(interaction(peragri_am, tot.prod_am, sep = "_", drop = TRUE))]
data[, agri_tree_am := as.integer(interaction(peragri_am, tree.mcq_am, sep = "_", drop = TRUE))]
