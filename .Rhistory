dbox <- "/Users/anzony.quisperojas/Library/CloudStorage/Dropbox/India_forest_land/replication_package"
root <- dbox
micro <- file.path(root, "A_MicroData")
rifbanks <- fread(file.path(micro, "district_match_final_RIB_BankEXPANSION.csv"))
dists <- unique(rifbanks[, .(codigo_estado_2011  , codigo_distrito_2011  )])
names(dists) <- c("pc11_s_id", "pc11_d_id")
dists$rif <- 1
#### Importing Subdistricts Covariables from CENSUS 2011
# pc11_td_bank_gov, pc11_td_bank_priv_com, pc11_td_bank_coop
df1.vd <- fread( file.path( micro, "pc11_vd_clean_shrid.csv"))
df1.vd <- df1.vd[, .( shrid2, pc11_vd_trctr, pc11_vd_t_p, banks = rowSums( .SD, na.rm = TRUE ) ),
.SDcols = c("pc11_vd_comm_bank", "pc11_vd_coop_bank")]
df1.vd[, c("pc11_s_id", "pc11_d_id", "pc11_sd_id") :=
lapply(tstrsplit(shrid2, "-", fixed = TRUE)[2:4], as.integer)]
df1.vd$count <- 1
df1.vd.sd <- df1.vd[, .(
tractors = sum(pc11_vd_trctr, na.rm = TRUE),
banks         = sum(banks, na.rm = TRUE),
pop = sum(pc11_vd_t_p, na.rm = TRUE),
count = sum(count)
), by = .(pc11_s_id, pc11_d_id, pc11_sd_id)]
df1.td <- fread( file.path( micro, "pc11_td_clean_shrid.csv"))
df1.td <- df1.td[, .(  shrid2, pc11_td_tot_p, banks = rowSums( .SD, na.rm = TRUE ) ),
.SDcols = c("pc11_td_bank_gov", "pc11_td_bank_coop", "pc11_td_bank_priv_com")]
df1.td$count <- 1
df1.td$tractors <- 0
df1.td[, c("pc11_s_id", "pc11_d_id", "pc11_sd_id") :=
lapply(tstrsplit(shrid2, "-", fixed = TRUE)[2:4], as.integer)]
df1.td.sd <- df1.td[, .(
tractors = sum(tractors, na.rm = TRUE),
banks         = sum(banks, na.rm = TRUE),
pop = sum(pc11_td_tot_p, na.rm = TRUE),
count = sum(count)
), by = .(pc11_s_id, pc11_d_id, pc11_sd_id)]
df.shrug <- rbind(df1.vd.sd, df1.td.sd)
df.shrug <- df.shrug[, .(
tractors = sum(tractors, na.rm = TRUE),
banks         = sum(banks, na.rm = TRUE),
pop = sum( pop, na.rm = TRUE)
), by = .(pc11_s_id, pc11_d_id, pc11_sd_id)]
df.shrug$tractors <- df.shrug$tractors *1000 / df.shrug$pop
df.shrug$banks <- df.shrug$banks *1000 / df.shrug$pop
df.shrug$rifscore2011 <-  df.shrug$pop/ df.shrug$banks
