#### Generating
data2010 <- data[ year == 2010,
.(pc11_s_id, pc11_d_id, pc11_sd_id,
peragri, perbarren,  tree.mcq,
rice, sugc, whea, pota, cotton,
cum_conflicts, tractors, banks) ]
cols_to_sum <- c("rice", "sugc", "whea", "cotton")
data2010[, tot.prod := rowSums(.SD, na.rm = TRUE), .SDcols = cols_to_sum]
data2010$tot.prod.log <- log(data2010$tot.prod+1)
quint_probs <- seq(0, 1, by = 0.1)
vars <- c("peragri", "tree.mcq", "rice", "sugc", "whea", "pota", "cotton", "perbarren" )
for (v in vars) {
# 1) compute cut‐points only on positive values
cuts <- data2010[get(v) > 0, quantile(get(v), probs = quint_probs, na.rm = TRUE)]
# 2) assign the quintile codes (1:5)
newcol <- paste0(v, "_d")
data2010[ , (newcol) :=
cut(get(v),
breaks         = cuts,
include.lowest = TRUE,
labels         = FALSE)]
# 3) replace any NA in the new quintile column with 1
data2010[ is.na(get(newcol)), (newcol) := 1L ]
}
data2010[, tree.mcq_by10 := cut(
tree.mcq,
breaks = seq(0, 1, by = 0.2),
labels = 1:5,
include.lowest = TRUE,
right = FALSE
)]
quint_probs <- seq(0, 1, by = 0.2)
vars <- c("peragri", "tree.mcq","tot.prod", "tot.prod.log", "rice", "sugc", "whea", "pota", "cotton" )
for (v in vars) {
# 1) compute cut‐points only on positive values
cuts <- data2010[get(v) > 0, quantile(get(v), probs = quint_probs, na.rm = TRUE)]
# 2) assign the quintile codes (1:5)
newcol <- paste0(v, "_q")
data2010[ , (newcol) :=
cut(get(v),
breaks         = cuts,
include.lowest = TRUE,
labels         = FALSE)]
# 3) replace any NA in the new quintile column with 1
data2010[ is.na(get(newcol)), (newcol) := 1L ]
}
vars <- c( 'tot.prod')
for (v in vars) {
# 1) compute cut‐points only on positive values
cuts <- data2010[, quantile(get(v), probs = quint_probs, na.rm = TRUE)]
# 2) assign the quintile codes (1:5)
newcol <- paste0(v, "_q")
data2010[ , (newcol) :=
cut(get(v),
breaks         = cuts,
include.lowest = TRUE,
labels         = FALSE)]
# 3) replace any NA in the new quintile column with 1
data2010[ is.na(get(newcol)), (newcol) := 1L ]
}
quint_probs <- seq(0, 1, by = 0.333333)
vars <- c("peragri", "tree.mcq", "tot.prod", "tot.prod.log", "rice", "sugc", "whea", "pota", "cotton" )
for (v in vars) {
# 1) compute cut‐points only on positive values
cuts <- data2010[get(v) > 0, quantile(get(v), probs = quint_probs, na.rm = TRUE)]
# 2) assign the quintile codes (1:5)
newcol <- paste0(v, "_t")
data2010[ , (newcol) :=
cut(get(v),
breaks         = cuts,
include.lowest = TRUE,
labels         = FALSE)]
# 3) replace any NA in the new quintile column with 1
data2010[ is.na(get(newcol)), (newcol) := 1L ]
}
quint_probs <- seq(0, 1, by = 0.5)
vars <- c("peragri", "tree.mcq", "rice", "sugc", "whea", "pota", "cotton", "tractors", "banks" )
for (v in vars) {
# 1) compute cut‐points only on positive values
cuts <- data2010[get(v) > 0, quantile(get(v), probs = quint_probs, na.rm = TRUE)]
# 2) assign the quintile codes (1:5)
newcol <- paste0(v, "_am")
data2010[ , (newcol) :=
cut(get(v),
breaks         = cuts,
include.lowest = TRUE,
labels         = FALSE)]
# 3) replace any NA in the new quintile column with 1
data2010[ is.na(get(newcol)), (newcol) := 1L ]
}
vars <- c( 'tot.prod')
for (v in vars) {
# 1) compute cut‐points only on positive values
cuts <- data2010[, quantile(get(v), probs = quint_probs, na.rm = TRUE)]
# 2) assign the quintile codes (1:5)
newcol <- paste0(v, "_am")
data2010[ , (newcol) :=
cut(get(v),
breaks         = cuts,
include.lowest = TRUE,
labels         = FALSE)]
# 3) replace any NA in the new quintile column with 1
data2010[ is.na(get(newcol)), (newcol) := 1L ]
}
# Change the names
vars     <- c( "peragri", "tree.mcq",
"rice",   "sugc",   "whea",     "pota", "perbarren",
"cum_conflicts",
"banks", "tractors")
new_names <- paste0(vars, "2010")
setnames(data2010, old = vars, new = new_names)
names(data2010)
############ Merging data
data <- merge(data, data2010, all.x = TRUE,
by = c("pc11_s_id", "pc11_d_id", "pc11_sd_id"))
data$allobs <- 1
data[, prod_tree_am := as.integer(interaction(tree.mcq_am, tot.prod_am, sep = "_", drop = TRUE))]
data[, prod_agri_am := as.integer(interaction(peragri_am, tot.prod_am, sep = "_", drop = TRUE))]
data[, agri_tree_am := as.integer(interaction(peragri_am, tree.mcq_am, sep = "_", drop = TRUE))]
################################################################################
################################################################################
####################### Importing Protected Areas ##############################
pr.area <- fread(file.path( micro, "protected_areas_sd.csv"))
data <- merge(data, pr.area, all.x=TRUE, by = c("pc11_s_id", "pc11_d_id", "pc11_sd_id"))
names(data)
data[is.na(protected_areas_sd), ]$protected_areas_sd <- 0
data[is.na(protected_areas_sd_10km), ]$protected_areas_sd_10km <- 0
data$protected_areas_sd <- data$protected_areas_sd+1
data$protected_areas_sd_10km <- data$protected_areas_sd_10km+1
table(data$protected_areas_sd_10km)
table(data$protected_areas_sd)
path <- file.path(micro, "_data_replication.csv")
fwrite(data, path)
